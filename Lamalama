.cosmos i:nth-child(4){top:34%;left:88%;animation-delay:2.4s}
.cosmos i:nth-child(5){top:18%;left:34%;width:2px;height:2px;animation-delay:3.2s}
.cosmos i:nth-child(6){top:42%;left:58%;animation-delay:1.1s}
.cosmos i:nth-child(7){top:6%;left:64%;width:5px;height:5px;background:#d4af37;animation-delay:2s}
.pair-card{position:relative}
.pair-card.found::after{content:'';position:absolute;inset:-18px;background:radial-gradient(circle,rgba(255,255,255,.95) 0%,rgba(255,255,255,0) 60%);pointer-events:none;animation:starFlash .8s ease-out forwards}
.pair-card.wrong{animation:answerWrong .25s ease-out}
.frag-in{animation:fragIn .25s ease-out}
.build.wrong{animation:buildShake .35s ease-in-out}
.build.wrong .frag-in{animation:grayOut .2s ease-in-out}
.card.correct-check{animation:answerCorrect .3s ease-out}
.card.wrong-check{animation:answerWrong .25s ease-out}
.final{animation:screenFadeUp .5s ease-out}
.world,.pair-card,.frag{animation:qFloatIn .35s ease-out}
.retry:active,.world:active,.card:active,.frag:active,.pair-card:active{animation:pressIn .08s ease forwards}
@media (prefers-reduced-motion: reduce){.cosmos i{animation:none;opacity:.6}}
</style>
</head>
<body>

<div class="cosmos" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
<div class="container">
<div class="header">
<h1>Испытание</h1>
<div class="subtitle">М.А. Булгаков · «Мастер и Маргарита»</div>
</div>

<div class="stages">
<div class="step active" id="s1"><div class="num">1</div><div>Три мира</div></div>
<div class="conn" id="c1"></div>
<div class="step" id="s2"><div class="num">2</div><div>Двойники</div></div>
<div class="conn" id="c2"></div>
<div class="step" id="s3"><div class="num">3</div><div>Цитаты</div></div>
</div>

<div class="counters">
<span>Блок: <strong id="block-num">1</strong> / 3</span>
<span class="err">Ошибок: <strong id="error-count">0</strong> / 5</span>
</div>

<div id="b1">
<div class="block-hdr">
<div class="block-title">Три мира</div>
<div class="block-desc">Кликни на героя, потом на мир. Шесть героев — три мира: Берлиоз и Иван в Москве, Пилат и Иешуа в Ершалаиме, Воланд и Кот в мистическом мире.</div>
</div>
<div class="worlds">
<div class="world moscow" data-world="moscow" onclick="zoneClick('moscow')"><div class="world-title">Москва 30-х</div><div class="world-content" id="content-moscow"></div></div>
<div class="world ershalaim" data-world="ershalaim" onclick="zoneClick('ershalaim')"><div class="world-title">Ершалаим</div><div class="world-content" id="content-ershalaim"></div></div>
<div class="world mystic" data-world="mystic" onclick="zoneClick('mystic')"><div class="world-title">Мистический мир</div><div class="world-content" id="content-mystic"></div></div>
</div>
<div class="pool" id="pool1"></div>
<div class="actions">
<div class="hint" id="hint1">Кликни на героя, потом на мир</div>
<button type="button" class="btn" id="check1" onclick="check1()" disabled>Проверить</button>
</div>
<div class="fb" id="fb1"><span id="fb1-text"></span></div>
</div>

<div id="b2" style="display:none">
<div class="block-hdr">
<div class="block-title">Двойники и отражения</div>
<div class="block-desc">Найди четыре пары двойников — героев из разных миров с одной функцией. Кликни на одного, потом на его отражение: Воланд и Пилат, Мастер и Иешуа, Коровьев и Афраний, Иван и Левий Матвей.</div>
</div>
<div class="pairs" id="pairs1"></div>
<div class="actions">
<div class="hint" id="hint2">Найдено пар: 0 / 4</div>
</div>
<div class="fb" id="fb2"><span id="fb2-text"></span></div>
</div>

<div id="b3" style="display:none">
<div class="block-hdr">
<div class="block-title">Восстанови цитату</div>
<div class="block-desc" id="hint3">Цитата 1 из 3. Кликай на фрагменты в правильном порядке.</div>
</div>
<div class="build" id="build"></div>
<div class="pool" id="pool3"></div>
<div class="actions">
<button type="button" class="btn" id="check3" onclick="check3()" disabled>Проверить</button>
</div>
<div class="fb" id="fb3"><span id="fb3-text"></span></div>
</div>

<div class="final" id="final">
<div class="final-title" id="final-title"></div>
<div class="final-text" id="final-text"></div>
<div class="stats" id="stats"></div>
<button type="button" class="retry" onclick="restart()">Пройти снова</button>
</div>
</div>

<script>
var totalErrors = 0;
var MAX = 5;
var b1Correct = 0;
var b2Correct = 0;
var b3Correct = 0;
var gameOver = false;

var chars = [
    {name:'Берлиоз', world:'moscow'},
    {name:'Иван Бездомный', world:'moscow'},
    {name:'Понтий Пилат', world:'ershalaim'},
    {name:'Иешуа Га-Ноцри', world:'ershalaim'},
    {name:'Воланд', world:'mystic'},
    {name:'Кот Бегемот', world:'mystic'}
];
var b1Sel = null;
var b1Placed = 0;

function initB1(){
    b1Sel = null;
    b1Placed = 0;
    b1Correct = 0;
    document.getElementById('content-moscow').innerHTML = '';
    document.getElementById('content-ershalaim').innerHTML = '';
    document.getElementById('content-mystic').innerHTML = '';
    var pool = document.getElementById('pool1');
    pool.innerHTML = '';
    var shuffled = chars.slice();
    for(var i = shuffled.length - 1; i > 0; i--){
        var j = Math.floor(Math.random() * (i + 1));
        var t = shuffled[i]; shuffled[i] = shuffled[j]; shuffled[j] = t;
    }
    for(var k = 0; k < shuffled.length; k++){
        (function(c){
            var el = document.createElement('div');
            el.className = 'card';
            el.innerText = c.name;
            el.dataset.world = c.world;
            el.onclick = function(e){ e.stopPropagation(); b1Select(el); };
            pool.appendChild(el);
        })(shuffled[k]);
    }
    document.getElementById('check1').disabled = true;
    document.getElementById('hint1').innerText = 'Кликни на героя, потом на мир';
}

function b1Select(el){
    if(gameOver) return;
    if(el.classList.contains('locked')) return;
    if(el.parentElement.classList.contains('world-content')){
        if(el.parentElement.id === 'content-' + el.dataset.world) return;
        el.parentElement.removeChild(el);
        document.getElementById('pool1').appendChild(el);
        b1Placed--;
        b1UpdateCheck();
        return;
    }
    if(b1Sel) b1Sel.classList.remove('selected');
    if(b1Sel === el){ b1Sel = null; return; }
    b1Sel = el;
    el.classList.add('selected');
}

function zoneClick(world){
    if(gameOver) return;
    if(!b1Sel) return;
    var content = document.getElementById('content-' + world);
    content.appendChild(b1Sel);
    b1Sel.classList.remove('selected');
    b1Sel = null;
    b1Placed++;
    b1UpdateCheck();
}

function b1UpdateCheck(){
    var poolCards = document.querySelectorAll('#pool1 .card');
    if(poolCards.length === 0){
        document.getElementById('check1').disabled = false;
        document.getElementById('hint1').innerText = 'Все распределены. Готов проверить?';
    } else {
        document.getElementById('check1').disabled = true;
        document.getElementById('hint1').innerText = 'Осталось: ' + poolCards.length;
    }
}

function check1(){
    var all = document.querySelectorAll('#b1 .card');
    var correct = 0;
    for(var i = 0; i < all.length; i++){
        var card = all[i];
        var par = card.parentElement;
        if(!par.classList.contains('world-content')) continue;
        var w = par.id.replace('content-','');
        card.classList.add('locked');
        if(w === card.dataset.world){ card.classList.add('correct-check'); correct++; }
        else { card.classList.add('wrong-check'); }
    }
    b1Correct = correct;
    var fb = document.getElementById('fb1');
    var fbText = document.getElementById('fb1-text');
    if(correct === 6){
        fb.className = 'fb correct';
        fbText.innerText = 'Отлично! Все шесть героев на своих местах.';
    } else {
        fb.className = 'fb wrong';
        var errs = 6 - correct;
        fbText.innerText = 'Ошибок: ' + errs + ' из 6.';
        totalErrors += errs;
        document.getElementById('error-count').innerText = totalErrors;
    }
    fb.style.display = 'block';
    document.getElementById('check1').disabled = true;
    if(totalErrors >= MAX){ gameOver = true; setTimeout(function(){ showFinal(false); }, 2000); return; }
    setTimeout(function(){
        document.getElementById('b1').style.display = 'none';
        document.getElementById('b2').style.display = 'block';
        document.getElementById('s1').classList.add('done');
        document.getElementById('s1').classList.remove('active');
        document.getElementById('s2').classList.add('active');
        document.getElementById('c1').classList.add('done');
        document.getElementById('block-num').innerText = '2';
        initB2();
    }, 2500);
}

var pairs = [
    {id:1, name:'Воланд', world:'Мистика', pid:2},
    {id:2, name:'Понтий Пилат', world:'Ершалаим', pid:1},
    {id:3, name:'Мастер', world:'Москва', pid:4},
    {id:4, name:'Иешуа', world:'Ершалаим', pid:3},
    {id:5, name:'Коровьев', world:'Мистика', pid:6},
    {id:6, name:'Афраний', world:'Ершалаим', pid:5},
    {id:7, name:'Иван Бездомный', world:'Москва', pid:8},
    {id:8, name:'Левий Матвей', world:'Ершалаим', pid:7}
];
var b2Found = 0;
var b2Sel = null;

function initB2(){
    b2Found = 0;
    b2Sel = null;
    var board = document.getElementById('pairs1');
    board.innerHTML = '';
    var shuffled = pairs.slice();
    for(var i = shuffled.length - 1; i > 0; i--){
        var j = Math.floor(Math.random() * (i + 1));
        var t = shuffled[i]; shuffled[i] = shuffled[j]; shuffled[j] = t;
    }
    for(var k = 0; k < shuffled.length; k++){
        (function(c){
            var el = document.createElement('div');
            el.className = 'pair-card';
            el.dataset.id = c.id;
            el.dataset.pid = c.pid;
            el.innerHTML = '<div class="pair-name">' + c.name + '</div><div class="pair-world">' + c.world + '</div>';
            el.onclick = function(){ b2Click(el); };
            board.appendChild(el);
        })(shuffled[k]);
    }
    document.getElementById('hint2').innerText = 'Найдено пар: 0 / 4';
    document.getElementById('fb2').style.display = 'none';
}

function b2Click(el){
    if(gameOver) return;
    if(el.classList.contains('found')) return;
    if(el.classList.contains('hidden')) return;
    if(el === b2Sel){ el.classList.remove('selected'); b2Sel = null; return; }
    if(!b2Sel){ el.classList.add('selected'); b2Sel = el; return; }
    var id1 = parseInt(b2Sel.dataset.id,10);
    var pid1 = parseInt(b2Sel.dataset.pid,10);
    var id2 = parseInt(el.dataset.id,10);
    var pid2 = parseInt(el.dataset.pid,10);
    var isPair = (pid1 === id2) && (pid2 === id1);
    if(isPair){
        var first = b2Sel; var second = el;
        first.classList.remove('selected');
        first.classList.add('found');
        second.classList.add('found');
        b2Found++;
        setTimeout(function(){ first.classList.add('hidden'); second.classList.add('hidden'); }, 700);
        document.getElementById('hint2').innerText = 'Найдено пар: ' + b2Found + ' / 4';
        b2Sel = null;
        if(b2Found === 4){ b2Correct = 4; setTimeout(finishB2, 1000); }
    } else {
        totalErrors++;
        document.getElementById('error-count').innerText = totalErrors;
        var f = b2Sel; var s = el;
        f.classList.remove('selected');
        f.classList.add('wrong');
        s.classList.add('wrong');
        b2Sel = null;
        setTimeout(function(){ f.classList.remove('wrong'); s.classList.remove('wrong'); }, 600);
        if(totalErrors >= MAX){ gameOver = true; setTimeout(function(){ showFinal(false); }, 1000); }
    }
}

function finishB2(){
    var fb = document.getElementById('fb2');
    fb.className = 'fb correct';
    document.getElementById('fb2-text').innerText = 'Все четыре пары найдены.';
    fb.style.display = 'block';
    setTimeout(function(){
        document.getElementById('b2').style.display = 'none';
        document.getElementById('b3').style.display = 'block';
        document.getElementById('s2').classList.add('done');
        document.getElementById('s2').classList.remove('active');
        document.getElementById('s3').classList.add('active');
        document.getElementById('c2').classList.add('done');
        document.getElementById('block-num').innerText = '3';
        initB3();
    }, 2000);
}

var quotes = [
    {fr:['Рукописи','не горят'], ord:[0,1]},
    {fr:['Кирпич','ни с того ни с сего','на голову','не свалится'], ord:[0,1,2,3]},
    {fr:['Никогда','не проси','ничего','у тех','кто сильнее тебя'], ord:[0,1,2,3,4]}
];
var b3Cur = 0;
var b3Solved = 0;
var b3Build = [];

function initB3(){
    b3Cur = 0;
    b3Solved = 0;
    b3Correct = 0;
    loadB3();
}

function loadB3(){
    if(b3Cur >= quotes.length){ b3Correct = b3Solved; finishB3(); return; }
    var q = quotes[b3Cur];
    b3Build = [];
    document.getElementById('hint3').innerText = 'Цитата ' + (b3Cur+1) + ' из 3';
    var build = document.getElementById('build');
    build.innerHTML = '';
    build.className = 'build';
    document.getElementById('fb3').style.display = 'none';
    document.getElementById('check3').disabled = true;
    var pool = document.getElementById('pool3');
    pool.innerHTML = '';
    var idx = [];
    for(var i = 0; i < q.fr.length; i++) idx.push(i);
    for(var k = idx.length - 1; k > 0; k--){
        var j = Math.floor(Math.random() * (k + 1));
        var t = idx[k]; idx[k] = idx[j]; idx[j] = t;
    }
    for(var m = 0; m < idx.length; m++){
        (function(i){
            var f = document.createElement('div');
            f.className = 'frag';
            f.innerText = q.fr[i];
            f.dataset.idx = i;
            f.onclick = function(){ pick3(f, i); };
            pool.appendChild(f);
        })(idx[m]);
    }
}

function pick3(el, i){
    if(gameOver) return;
    if(el.classList.contains('used')) return;
    var q = quotes[b3Cur];
    b3Build.push(i);
    el.classList.add('used');
    var build = document.getElementById('build');
    var f = document.createElement('div');
    f.className = 'frag-in';
    f.innerText = q.fr[i];
    f.dataset.idx = i;
    f.onclick = function(){ remove3(f, i, el); };
    build.appendChild(f);
    if(b3Build.length === q.fr.length) document.getElementById('check3').disabled = false;
}

function remove3(f, i, orig){
    if(gameOver) return;
    var pos = b3Build.indexOf(i);
    if(pos !== -1) b3Build.splice(pos, 1);
    f.remove();
    orig.classList.remove('used');
    document.getElementById('check3').disabled = true;
}

function check3(){
    var q = quotes[b3Cur];
    var ok = true;
    for(var i = 0; i < q.ord.length; i++){ if(b3Build[i] !== q.ord[i]){ ok = false; break; } }
    var build = document.getElementById('build');
    var fb = document.getElementById('fb3');
    var fbt = document.getElementById('fb3-text');
    if(ok){
        build.classList.add('correct');
        fb.className = 'fb correct';
        fbt.innerText = 'Верно!';
        fb.style.display = 'block';
        b3Solved++;
        document.getElementById('check3').disabled = true;
        setTimeout(function(){ b3Cur++; loadB3(); }, 1800);
    } else {
        totalErrors++;
        document.getElementById('error-count').innerText = totalErrors;
        build.classList.add('wrong');
        fb.className = 'fb wrong';
        var correctText = '';
        for(var j = 0; j < q.ord.length; j++) correctText += q.fr[q.ord[j]] + (j < q.ord.length-1 ? ' ' : '');
        fbt.innerText = 'Неверно. Правильно было: «' + correctText + '»';
        fb.style.display = 'block';
        document.getElementById('check3').disabled = true;
        if(totalErrors >= MAX){ gameOver = true; setTimeout(function(){ showFinal(false); }, 2000); return; }
        setTimeout(function(){ build.classList.remove('wrong'); loadB3(); }, 2500);
    }
}

function finishB3(){ setTimeout(function(){ showFinal(true); }, 800); }

function showFinal(win){
    document.getElementById('b1').style.display = 'none';
    document.getElementById('b2').style.display = 'none';
    document.getElementById('b3').style.display = 'none';
    var f = document.getElementById('final');
    f.style.display = 'block';
    var title = document.getElementById('final-title');
    var text = document.getElementById('final-text');
    var stats = document.getElementById('stats');
    if(win && totalErrors < MAX){
        title.className = 'final-title win';
        title.innerText = 'РУКОПИСИ НЕ ГОРЯТ';
        text.innerText = 'Ты прошёл все три испытания: распределил героев, нашёл двойников, восстановил цитаты. Роман собран.';
    } else {
        title.className = 'final-title lose';
        title.innerText = 'РОМАН РАССЫПАЛСЯ';
        text.innerText = 'Слишком много ошибок. Воланд исчез, герои разбрелись по чужим мирам, цитаты сгорели.';
    }
    var html = '';
    html += '<div class="stat-row ' + (b1Correct===6?'perfect':'') + '"><div class="stat-name">Блок 1 · Три мира</div><div class="stat-val">' + b1Correct + ' / 6</div></div>';
    html += '<div class="stat-row ' + (b2Correct===4?'perfect':'') + '"><div class="stat-name">Блок 2 · Двойники</div><div class="stat-val">' + b2Correct + ' / 4</div></div>';
    html += '<div class="stat-row ' + (b3Correct===3?'perfect':'') + '"><div class="stat-name">Блок 3 · Цитаты</div><div class="stat-val">' + b3Correct + ' / 3</div></div>';
    html += '<div class="total">Ошибок всего: <strong>' + totalErrors + '</strong> из ' + MAX + '</div>';
    stats.innerHTML = html;
}

function restart(){ location.reload(); }

initB1();
</script>
</body>
</html>
</template>
<!-- ================= ЛОГИКА САЙТА ================= -->
<script>
(function(){
    'use strict';

    /* --- Прогресс-бар скролла --- */
    var progressBar = document.getElementById('scrollProgress');
    function updateProgress(){
        var docH = document.documentElement.scrollHeight - window.innerHeight;
        var scrolled = docH > 0 ? (window.scrollY / docH) * 100 : 0;
        progressBar.style.width = scrolled + '%';
    }
    window.addEventListener('scroll', updateProgress, {passive:true});
    updateProgress();

    /* --- Reveal-анимации --- */
    var revealEls = document.querySelectorAll('.reveal');
    if('IntersectionObserver' in window){
        var revealObs = new IntersectionObserver(function(entries){
            entries.forEach(function(entry){
                if(entry.isIntersecting){
                    entry.target.classList.add('visible');
                    revealObs.unobserve(entry.target);
                }
            });
        }, {threshold:.12, rootMargin:'0px 0px -40px 0px'});
        revealEls.forEach(function(el){ revealObs.observe(el); });
    } else {
        revealEls.forEach(function(el){ el.classList.add('visible'); });
    }

    /* --- Анимация счётчиков в hero --- */
    var counters = document.querySelectorAll('.hero-stat .num[data-count]');
    counters.forEach(function(el){
        var target = parseInt(el.getAttribute('data-count'), 10) || 0;
        var startTime = null;
        function step(ts){
            if(!startTime) startTime = ts;
            var p = Math.min((ts - startTime) / 900, 1);
            el.textContent = Math.round(target * p);
            if(p < 1) requestAnimationFrame(step);
        }
        setTimeout(function(){ requestAnimationFrame(step); }, 400);
    });

    /* --- Активный пункт меню --- */
    var navLinks = document.querySelectorAll('#mainNav a');
    var sections = [];
    navLinks.forEach(function(link){
        var secId = link.getAttribute('href').slice(1);
        var sec = document.getElementById(secId);
        if(sec) sections.push({id:secId, el:sec, link:link});
    });
    function updateActiveNav(){
        var pos = window.scrollY + 120;
        var current = null;
        sections.forEach(function(s){
            if(s.el.offsetTop <= pos) current = s;
        });
        navLinks.forEach(function(l){ l.classList.remove('active'); });
        if(current) current.link.classList.add('active');
    }
    window.addEventListener('scroll', updateActiveNav, {passive:true});
    updateActiveNav();

    /* --- Фильтры игр --- */
    var filterBtns = document.querySelectorAll('.filter-btn');
    var gameCards = document.querySelectorAll('.game-card');
    filterBtns.forEach(function(btn){
        btn.addEventListener('click', function(){
            filterBtns.forEach(function(b){ b.classList.remove('active'); });
            btn.classList.add('active');
            var filter = btn.getAttribute('data-filter');
            gameCards.forEach(function(card, idx){
                var show = (filter === 'all') || (card.getAttribute('data-grade') === filter);
                if(show){
                    card.classList.remove('hidden-card');
                    card.classList.add('visible');
                    card.style.animation = 'none';
                    void card.offsetWidth;
                    card.style.animation = 'cardIn .4s ease ' + (idx * 0.05) + 's both';
                } else {
                    card.classList.add('hidden-card');
                }
            });
        });
    });

    /* --- Модальное окно с игрой --- */
    var modal = document.getElementById('gameModal');
    var modalFrame = document.getElementById('gameFrame');
    var modalTitle = document.getElementById('modalTitle');
    var modalClose = document.getElementById('modalClose');

    function openGame(card){
        var tplId = card.getAttribute('data-tpl');
        var title = card.getAttribute('data-title') || 'Игра';
        var tpl = document.getElementById(tplId);
        if(!tpl){
            alert('Шаблон игры не найден: ' + tplId);
            return;
        }

        var html = tpl.innerHTML;

        if(!html || html.trim().length < 50){
            alert('Шаблон пустой: ' + tplId);
            return;
        }

        html = html
            .replace(/<!DOCTYPE[^>]*>/gi, '')
            .replace(/<\/?(?:html|head|body)(?:\s[^>]*)?>/gi, '');

        var safetyCSS = '<style>' +
            '@media (prefers-reduced-motion: reduce){' +
