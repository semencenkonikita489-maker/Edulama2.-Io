<script>
var QUESTIONS = [
    { quote: 'Тварь ли я дрожащая или право имею?', options: ['Раскольников','Соня','Мармеладов','Лужин'], correct: 'Раскольников', context: 'Внутренний монолог Раскольникова, суть его теории. Часть 3, глава 5.' },
    { quote: 'Ведь надобно же, чтобы всякому человеку хоть куда-нибудь можно было пойти', options: ['Раскольников','Мармеладов','Свидригайлов','Порфирий Петрович'], correct: 'Мармеладов', context: 'Слова Мармеладова в трактире. Часть 1, глава 2.' },
    { quote: 'Что вы, что вы это над собой сделали!', options: ['Соня','Дуня','Раскольников','Мармеладов'], correct: 'Соня', context: 'Соня говорит это Раскольникову, когда узнаёт о преступлении. Часть 5, глава 4.' },
    { quote: 'Я ведь не старушонку убил, я себя убил', options: ['Свидригайлов','Раскольников','Порфирий Петрович','Лужин'], correct: 'Раскольников', context: 'Признание Соне. Часть 5, глава 4.' },
    { quote: 'Возлюби прежде всего одного себя, ибо всё на свете на личном интересе основано', options: ['Лужин','Свидригайлов','Порфирий Петрович','Разумихин'], correct: 'Лужин', context: 'Теория Лужина. Часть 2, глава 5.' },
    { quote: 'Я, сударь, человек пропащий', options: ['Мармеладов','Раскольников','Свидригайлов','Порфирий Петрович'], correct: 'Мармеладов', context: 'В трактире, о себе. Часть 1, глава 2.' },
    { quote: 'Вы убили, Родион Романович!', options: ['Порфирий Петрович','Свидригайлов','Разумихин','Раскольников'], correct: 'Порфирий Петрович', context: 'Прямое обвинение. Часть 4, глава 5.' },
    { quote: 'Пойдём вместе... Я с тобой пойду', options: ['Соня','Дуня','Раскольников','Мармеладов'], correct: 'Соня', context: 'Соня о каторге. Часть 5, глава 4.' },
    { quote: 'Вы больны, батенька', options: ['Порфирий Петрович','Разумихин','Раскольников','Свидригайлов'], correct: 'Порфирий Петрович', context: 'Первая встреча. Часть 3, глава 5.' },
    { quote: 'Знаете ли вы, что значит, когда уже некуда больше идти?', options: ['Мармеладов','Соня','Раскольников','Лужин'], correct: 'Мармеладов', context: 'О Соне. Часть 1, глава 2.' }
];

var TOTAL = QUESTIONS.length;
var currentIndex = 0;
var score = 0;
var litCount = 0;
var wrongAnswers = [];

function shuffleArray(arr){
    for(var i = arr.length - 1; i > 0; i--){
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
    }
    return arr;
}

function startGame(){
    currentIndex = 0;
    score = 0;
    litCount = 0;
    wrongAnswers = [];
    document.getElementById('game-screen').style.display = 'block';
    document.getElementById('final-screen').style.display = 'none';
    var windows = document.querySelectorAll('.window');
    for(var i = 0; i < windows.length; i++) windows[i].classList.remove('lit');
    showQuestion();
}

function showQuestion(){
    if(currentIndex >= TOTAL){ showFinal(); return; }
    var q = QUESTIONS[currentIndex];
    document.getElementById('feedback').style.display = 'none';
    document.getElementById('next-btn').disabled = true;
    document.getElementById('q-counter').innerText = (currentIndex + 1) + ' / ' + TOTAL;
    document.getElementById('lit-counter').innerText = litCount;
    var qHost = document.getElementById('quote-text');
    qHost.innerHTML = '';
    var qSpan = document.createElement('span');
    qSpan.className = 'q-inner';
    qSpan.textContent = q.quote;
    qHost.appendChild(qSpan);
    var grid = document.getElementById('options-grid');
    grid.innerHTML = '';
    var shuffled = shuffleArray(q.options.slice());
    for(var i = 0; i < shuffled.length; i++){
        (function(opt){
            var btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.type = 'button';
            btn.innerText = opt;
            btn.onclick = function(){ checkAnswer(opt, btn); };
            grid.appendChild(btn);
        })(shuffled[i]);
    }
}

function checkAnswer(selected, clickedBtn){
    var q = QUESTIONS[currentIndex];
    var allBtns = document.querySelectorAll('.option-btn');
    for(var i = 0; i < allBtns.length; i++) allBtns[i].disabled = true;
    var isCorrect = (selected === q.correct);
    var fb = document.getElementById('feedback');
    var fbTitle = document.getElementById('fb-title');
    var fbText = document.getElementById('fb-text');
    var fbContext = document.getElementById('fb-context');
    if(isCorrect){
        score++;
        litCount++;
        clickedBtn.classList.add('correct');
        var win = document.querySelector('.window[data-i="' + currentIndex + '"]');
        if(win) win.classList.add('lit');
        fb.className = 'feedback correct';
        fbTitle.innerText = 'Верно!';
        fbText.innerText = ' Это ' + q.correct + '.';
        fbContext.innerText = q.context;
    } else {
        clickedBtn.classList.add('wrong');
        for(var j = 0; j < allBtns.length; j++){
            if(allBtns[j].innerText === q.correct) allBtns[j].classList.add('correct');
        }
        wrongAnswers.push({ quote: q.quote, correct: q.correct, yourAnswer: selected });
        fb.className = 'feedback wrong';
        fbTitle.innerText = 'Неверно.';
        fbText.innerText = ' Правильный ответ: ' + q.correct + '.';
        fbContext.innerText = q.context;
    }
    fb.style.display = 'block';
    document.getElementById('lit-counter').innerText = litCount;
    document.getElementById('next-btn').disabled = false;
}

function nextQuestion(){
    currentIndex++;
    if(currentIndex < TOTAL){ showQuestion(); } else { showFinal(); }
}

function showFinal(){
    document.getElementById('game-screen').style.display = 'none';
    document.getElementById('final-screen').style.display = 'block';
    document.getElementById('final-score').innerText = score;
    var percent = (score / TOTAL) * 100;
    var verdict = '';
    if(percent === 100){ verdict = 'Идеально. Ты знаешь роман наизусть — слышишь голос каждого героя.'; }
    else if(percent >= 90){ verdict = 'Отлично. Ты внимательный читатель, почти не путаешь героев.'; }
    else if(percent >= 70){ verdict = 'Хорошо. Основные персонажи узнаются, но некоторые голоса сливаются.'; }
    else if(percent >= 50){ verdict = 'Удовлетворительно. Ты путаешь героев, голоса не различаешь. Стоит перечитать.'; }
    else { verdict = 'Плохо. Ты не знаешь, кто говорит в романе. Перечитай — и попробуй снова.'; }
    if(wrongAnswers.length > 0){
        var quotesList = [];
        for(var i = 0; i < wrongAnswers.length; i++){
            quotesList.push('«' + wrongAnswers[i].quote.substring(0, 40) + '...»');
        }
        verdict += ' Ошибки были в цитатах: ' + quotesList.join(', ') + '.';
    }
    document.getElementById('final-verdict').innerText = verdict;
}

startGame();
</script>
</body>
</html>
