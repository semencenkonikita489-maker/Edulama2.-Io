<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Вайбкодинг в методическом арсенале педагога — МГПУ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700;800&family=Merriweather:wght@400;700&family=Special+Elite&family=Oswald:wght@400;600&family=Russo+One&family=Playfair+Display:wght@400;700&family=PT+Serif:ital,wght@0,400;0,700;1,400&family=PT+Sans:wght@400;700&family=Marcellus&family=Marck+Script&display=swap" rel="stylesheet">
<style>
:root{--red:#EE3524;--red-dark:#C62A1C;--red-soft:rgba(238,53,36,.08);--graphite:#4D4D4F;--graphite-dark:#2B2B2D;--graphite-deep:#1E1E20;--silver:#A7A9AC;--silver-light:#E4E5E7;--bg:#F4F4F5;--white:#FFFFFF;--text:#2E2E30;--muted:#6E6E72;--radius:14px;--shadow:0 10px 30px rgba(30,30,32,.08);--shadow-lg:0 20px 50px rgba(30,30,32,.14)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Inter',Helvetica,Arial,sans-serif;background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden}
h1,h2,h3,h4,.brand-name{font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif}
.slide-tag,.hero-badge,.game-genre,.compare-col h3{font-family:'Inter',Helvetica,Arial,sans-serif;text-transform:uppercase;letter-spacing:2.5px}
.key-phrase{font-family:'Cormorant Garamond',Georgia,serif;font-style:italic;font-weight:600}
.final-quote .fq-text{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600}
.footer-title{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600}
.grade-card .g-title{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600}
.game-body h3{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600}
.quote,.ai-table td,.note{font-family:'Merriweather',Georgia,serif}
img{max-width:100%}
button{font-family:inherit}
.site-header{position:fixed;top:0;left:0;right:0;z-index:900;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);box-shadow:0 1px 0 var(--silver-light)}
.header-inner{max-width:1200px;margin:0 auto;padding:0 24px;height:66px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0}
.brand-rings{position:relative;width:38px;height:38px;flex-shrink:0}
.brand-rings span{position:absolute;border-radius:50%;border:2.5px solid var(--red)}
.brand-rings span:nth-child(1){inset:0}
.brand-rings span:nth-child(2){inset:6px;opacity:.75}
.brand-rings span:nth-child(3){inset:12px;opacity:.5}
.brand-text{display:flex;flex-direction:column;line-height:1.15}
.brand-name{font-weight:700;font-size:17px;color:var(--graphite-dark);letter-spacing:1px}
.brand-sub{font-size:10px;color:var(--silver);letter-spacing:1.5px;text-transform:uppercase;font-weight:600}
.main-nav{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none}
.main-nav::-webkit-scrollbar{display:none}
.main-nav a{white-space:nowrap;text-decoration:none;font-size:12.5px;font-weight:600;color:var(--muted);padding:8px 12px;border-radius:8px;transition:all .2s}
.main-nav a:hover{color:var(--red);background:var(--red-soft)}
.main-nav a.active{color:var(--white);background:var(--red)}
.scroll-progress{position:absolute;bottom:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--red),#ff6a52);transition:width .1s linear}
.hero{position:relative;background:linear-gradient(135deg,var(--graphite-deep) 0%,var(--graphite-dark) 55%,#3a3a3d 100%);color:var(--white);padding:150px 24px 90px;overflow:hidden}
.hero-rings{position:absolute;right:-180px;top:50%;transform:translateY(-50%);width:640px;height:640px;opacity:.22;pointer-events:none}
.hero-rings circle{fill:none;stroke:var(--red);stroke-width:3;transform-origin:320px 320px}
.hero-rings .r1{animation:ringPulse 6s ease-in-out infinite,ringRotate 22s linear infinite}
.hero-rings .r2{animation:ringPulse 6s ease-in-out 1.5s infinite,ringRotate 30s linear infinite reverse}
.hero-rings .r3{animation:ringPulse 6s ease-in-out 3s infinite,ringRotate 40s linear infinite}
@keyframes ringPulse{0%,100%{opacity:.35;stroke-width:3}50%{opacity:1;stroke-width:4.5}}
@keyframes ringRotate{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
.hero-grid-lines{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:56px 56px;pointer-events:none}
.hero-inner{max-width:1200px;margin:0 auto;position:relative;z-index:2}
.hero-badges{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:26px}
.hero-badge{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;padding:7px 16px;border-radius:30px}
.hero-badge.red{background:var(--red);color:#fff}
.hero-badge.ghost{border:1.5px solid rgba(255,255,255,.35);color:#e8e8ea}
.hero h1{font-size:clamp(30px,5vw,54px);font-weight:700;line-height:1.12;letter-spacing:-.5px;max-width:850px;margin-bottom:20px}
.hero h1 .accent{color:var(--red);background:linear-gradient(transparent 62%, rgba(238,53,36,.22) 62%);padding:0 3px}
.hero-lead{font-size:clamp(15px,2vw,19px);color:#c9c9cd;max-width:720px;margin-bottom:34px;font-weight:400}
.hero-lead strong{color:#fff}
.hero-authors{display:flex;flex-wrap:wrap;gap:14px 28px;align-items:center;padding:20px 24px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-left:4px solid var(--red);border-radius:12px;margin-bottom:34px;max-width:760px}
.author-block{display:flex;flex-direction:column;gap:2px}
.author-label{font-size:10.5px;text-transform:uppercase;letter-spacing:1.5px;color:var(--silver);font-weight:700}
.author-value{font-size:15px;color:#fff;font-weight:600}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:56px}
.btn-hero{display:inline-flex;align-items:center;gap:9px;text-decoration:none;font-weight:700;font-size:15px;padding:16px 34px;border-radius:10px;transition:all .25s;letter-spacing:.3px}
.btn-hero.primary{background:var(--red);color:#fff;box-shadow:0 8px 24px rgba(238,53,36,.35)}
.btn-hero.primary:hover{background:#ff4a38;transform:translateY(-2px);box-shadow:0 12px 30px rgba(238,53,36,.45)}
.btn-hero.secondary{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.4)}
.btn-hero.secondary:hover{border-color:#fff;background:rgba(255,255,255,.08)}
.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:860px}
.hero-stat{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:20px 22px}
.hero-stat .num{font-family:'Inter',sans-serif;font-size:36px;font-weight:800;color:var(--red);line-height:1}
.hero-stat .lbl{font-size:12px;color:#b8b8bd;margin-top:6px;font-weight:500}
.section{max-width:1200px;margin:0 auto;padding:80px 24px}
.slide-card{background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);padding:44px 48px;position:relative;overflow:hidden}
.slide-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--red)}
.slide-tag{display:inline-flex;align-items:center;gap:10px;font-size:11px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--silver);margin-bottom:14px}
.slide-tag .dot{width:8px;height:8px;border-radius:50%;background:var(--red)}
.slide-card h2{font-size:clamp(24px,3.4vw,34px);font-weight:700;color:var(--graphite-dark);line-height:1.2;margin-bottom:14px;letter-spacing:-.3px}
.slide-desc{font-size:16px;color:var(--muted);max-width:760px;margin-bottom:34px}
.reveal{opacity:0;transform:translateY(28px);transition:opacity .7s ease,transform .7s ease}
.reveal.visible{opacity:1;transform:translateY(0)}
.note{margin-top:28px;padding:16px 20px;background:var(--bg);border-radius:10px;font-size:13.5px;color:var(--muted);font-style:italic;border:1px dashed var(--silver-light)}
.note b{color:var(--graphite);font-style:normal}
.compare{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.compare-col{border-radius:12px;padding:28px;border:1px solid var(--silver-light)}
.compare-col h3{font-size:13px;letter-spacing:2.5px;text-transform:uppercase;margin-bottom:20px;font-weight:800}
.compare-col.before{background:#f2f2f3}
.compare-col.before h3{color:var(--silver)}
.compare-col.after{background:linear-gradient(160deg,#fff5f4,#fff);border-color:rgba(238,53,36,.3)}
.compare-col.after h3{color:var(--red)}
.compare-item{display:flex;gap:12px;align-items:flex-start;padding:11px 0;font-size:14.5px;color:var(--text)}
.compare-item .ic{flex-shrink:0;width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;margin-top:1px}
.before .ic{background:#dcdcdf;color:var(--muted)}
.after .ic{background:var(--red);color:#fff}
.vibe-loop{display:flex;align-items:stretch;gap:0;flex-wrap:wrap;margin-bottom:26px}
.vibe-step{flex:1;min-width:150px;background:var(--bg);border-radius:12px;padding:22px 18px;text-align:center;position:relative;transition:all .25s;border:2px solid transparent}
.vibe-step:hover{border-color:var(--red);transform:translateY(-4px);box-shadow:var(--shadow)}
.vibe-step .v-num{width:34px;height:34px;margin:0 auto 10px;border-radius:50%;background:var(--graphite-dark);color:#fff;display:flex;align-items:center;justify-content:center;font-family:'Inter',sans-serif;font-weight:800;font-size:14px}
.vibe-step:hover .v-num{background:var(--red)}
.vibe-step .v-title{font-family:'Inter',sans-serif;font-weight:700;font-size:15px;color:var(--graphite-dark);margin-bottom:4px}
.vibe-step .v-sub{font-size:12px;color:var(--muted)}
.vibe-arrow{display:flex;align-items:center;padding:0 10px;color:var(--silver);font-size:22px;font-weight:700}
.fact-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.fact{background:var(--bg);border-radius:10px;padding:18px 20px;font-size:14px;color:var(--text)}
.fact b{color:var(--red)}
.steps-big{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.step-big{background:var(--bg);border-radius:12px;padding:28px 22px;position:relative;transition:all .25s;border-top:3px solid var(--silver)}
.step-big:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg);border-top-color:var(--red)}
.step-big .s-num{font-family:'Inter',sans-serif;font-size:52px;font-weight:800;color:var(--silver-light);line-height:1;margin-bottom:12px;transition:color .25s}
.step-big:hover .s-num{color:var(--red)}
.step-big h3{font-size:18px;font-weight:600;color:var(--graphite-dark);margin-bottom:8px}
.step-big p{font-size:13.5px;color:var(--muted)}
.key-phrase{margin-top:26px;padding:22px 28px;background:var(--graphite-dark);color:#fff;border-radius:12px;font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:600;font-size:clamp(16px,2.2vw,21px);text-align:center;letter-spacing:.3px}
.key-phrase .q{color:var(--red);font-size:1.3em;line-height:0}
.code-steps{display:flex;flex-direction:column;gap:0}
.code-step{display:flex;gap:18px;align-items:flex-start;padding:16px 0;position:relative}
.code-step:not(:last-child)::after{content:'';position:absolute;left:19px;top:56px;bottom:-4px;width:2px;background:var(--silver-light)}
.code-step .c-num{flex-shrink:0;width:40px;height:40px;border-radius:50%;background:var(--white);border:2.5px solid var(--red);color:var(--red);display:flex;align-items:center;justify-content:center;font-family:'Inter',sans-serif;font-weight:800;font-size:16px;z-index:1}
.code-step .c-text{padding-top:7px;font-size:15px;color:var(--text)}
.code-step .c-text b{color:var(--graphite-dark)}
.code-step .c-text code{background:var(--bg);padding:2px 6px;border-radius:4px;font-family:'Courier New',monospace;font-size:13px;color:var(--red)}
.sandbox-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.sandbox-chip{background:var(--bg);border:1px solid var(--silver-light);border-radius:30px;padding:8px 18px;font-size:13px;font-weight:600;color:var(--graphite);transition:all .2s}
.sandbox-chip:hover{border-color:var(--red);color:var(--red);background:var(--red-soft)}
.games-hero{background:linear-gradient(135deg,var(--graphite-deep),var(--graphite-dark));border-radius:0;padding:70px 24px 80px;position:relative;overflow:hidden}
.games-hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:48px 48px}
.games-hero-inner{max-width:1200px;margin:0 auto;position:relative;z-index:2;text-align:center}
.games-hero .slide-tag{color:var(--silver);justify-content:center}
.games-hero h2{color:#fff;font-size:clamp(26px,4vw,40px);font-weight:800;margin-bottom:12px}
.games-hero p{color:#b8b8bd;font-size:16px;max-width:640px;margin:0 auto 34px}
.filters{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.filter-btn{background:rgba(255,255,255,.07);border:1.5px solid rgba(255,255,255,.18);color:#d8d8dc;font-weight:600;font-size:13.5px;padding:10px 24px;border-radius:30px;cursor:pointer;transition:all .25s}
.filter-btn:hover{border-color:rgba(255,255,255,.5);color:#fff}
.filter-btn.active{background:var(--red);border-color:var(--red);color:#fff;box-shadow:0 6px 18px rgba(238,53,36,.4)}
.games-grid{max-width:1200px;margin:-40px auto 0;padding:0 24px 90px;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;position:relative;z-index:5}
.game-card{background:var(--white);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);transition:transform .3s,box-shadow .3s;display:flex;flex-direction:column;cursor:pointer}
@keyframes cardIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.game-card:hover{transform:translateY(-7px);box-shadow:var(--shadow-lg)}
.game-card.hidden-card{display:none}
.game-thumb{height:170px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
.game-thumb .thumb-emoji{font-size:66px;filter:drop-shadow(0 8px 18px rgba(0,0,0,.45));transition:transform .35s;z-index:2}
.game-card:hover .thumb-emoji{transform:scale(1.14) rotate(-4deg)}
.game-thumb::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 70% 20%,rgba(255,255,255,.14),transparent 55%)}
.game-thumb .g-num{position:absolute;top:14px;left:16px;font-family:'Inter',sans-serif;font-size:11px;font-weight:800;letter-spacing:2.5px;color:rgba(255,255,255,.85);text-transform:uppercase;z-index:3}
.game-thumb .g-class{position:absolute;top:12px;right:12px;background:rgba(0,0,0,.35);backdrop-filter:blur(4px);color:#fff;font-size:11px;font-weight:700;padding:5px 12px;border-radius:20px;z-index:3;border:1px solid rgba(255,255,255,.2)}
.t1{background:linear-gradient(140deg,#1c3a2a,#2d5a3d 60%,#3a6b48)}
.t2{background:linear-gradient(140deg,#3a2a1a,#5a4028 60%,#6b4e30)}
.t3{background:linear-gradient(140deg,#2b1a1a,#4a2424 60%,#5c2e2e)}
.t4{background:linear-gradient(140deg,#231f33,#3a3252 60%,#4a4066)}
.t5{background:linear-gradient(140deg,#2a2233,#4a3a58 60%,#5c4a6e)}
.t6{background:linear-gradient(140deg,#101420,#1e2637 60%,#2a344a)}
.t7{background:linear-gradient(140deg,#1a0f28,#2e1a44 60%,#3d2258)}
.game-body{padding:22px 24px 24px;display:flex;flex-direction:column;flex:1}
.game-genre{font-size:10.5px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:var(--red);margin-bottom:8px}
.game-body h3{font-size:19px;font-weight:600;color:var(--graphite-dark);line-height:1.25;margin-bottom:3px}
.game-author{font-size:13px;color:var(--silver);font-style:italic;margin-bottom:12px}
.game-body p{font-size:13.5px;color:var(--muted);line-height:1.6;margin-bottom:20px;flex:1}
.play-btn{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;background:var(--graphite-dark);color:#fff;border:none;font-family:'Inter',sans-serif;font-weight:700;font-size:13.5px;letter-spacing:1px;text-transform:uppercase;padding:14px;border-radius:10px;cursor:pointer;transition:all .25s;pointer-events:none}
.game-card:hover .play-btn{background:var(--red);box-shadow:0 8px 20px rgba(238,53,36,.35)}
.play-btn .tri{font-size:10px}
.grade-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.grade-cards .grade-card:last-child{grid-column:1 / -1}
.grade-card{background:var(--bg);border-radius:12px;padding:28px 24px;border-top:4px solid var(--graphite);transition:all .25s}
.grade-card:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-top-color:var(--red)}
.grade-card .g-title{font-weight:600;font-size:21px;color:var(--graphite-dark);margin-bottom:4px}
.grade-card .g-sub{font-size:12px;color:var(--silver);font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-bottom:18px}
.grade-card ul{list-style:none;display:flex;flex-direction:column;gap:12px;margin-bottom:18px}
.grade-card li{font-size:13.5px;color:var(--text);padding-left:20px;position:relative}
.grade-card li::before{content:'';position:absolute;left:0;top:7px;width:8px;height:8px;border-radius:2px;background:var(--red)}
.mini-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:22px}
.mini-card{background:var(--bg);border:1px solid var(--silver-light);border-left:3px solid var(--red);border-radius:12px;padding:18px 20px;transition:transform .25s ease,box-shadow .25s ease,border-left-color .25s ease}
.mini-card:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-left-color:var(--graphite)}
.mini-card .m-ic{font-size:20px;line-height:1;margin-bottom:8px}
.mini-card h3{font-size:18px;font-weight:600;color:var(--graphite-dark);margin-bottom:6px}
.mini-card p{font-size:14px;line-height:1.6;color:var(--text)}
.table-wrap{overflow-x:auto;border-radius:12px;border:1px solid var(--silver-light)}
.ai-table{width:100%;border-collapse:collapse;font-size:13.5px;min-width:1080px}
.ai-table .vpn{font-weight:700;white-space:nowrap;color:var(--graphite-dark)}
.ai-table .vpn.no{color:var(--red)}
.ai-table th{background:var(--graphite-dark);color:#fff;font-family:'Inter',sans-serif;font-weight:700;font-size:11.5px;letter-spacing:1.5px;text-transform:uppercase;padding:15px 18px;text-align:left}
.ai-table td{padding:15px 18px;border-bottom:1px solid var(--silver-light);vertical-align:top;color:var(--text);background:var(--white)}
.ai-table tr:last-child td{border-bottom:none}
.ai-table tr:hover td{background:#fafafb}
.ai-table .svc{font-family:'Inter',sans-serif;font-weight:800;color:var(--graphite-dark);white-space:nowrap}
.ai-table .svc span{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--red);margin-right:8px}
.risks-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.risk{background:var(--bg);border-radius:12px;padding:24px 22px;border-left:4px solid var(--red);transition:all .25s}
.risk:hover{background:#fff;box-shadow:var(--shadow);transform:translateY(-3px)}
.risk .r-ic{font-size:26px;margin-bottom:12px}
.risk h3{font-size:15px;font-weight:700;color:var(--graphite-dark);margin-bottom:7px}
.risk p{font-size:13px;color:var(--muted);line-height:1.55}
.final-quote{background:linear-gradient(135deg,var(--graphite-deep),var(--graphite-dark));border-radius:var(--radius);padding:56px 48px;text-align:center;color:#fff;position:relative;overflow:hidden}
.final-quote::before{content:'«';position:absolute;top:-30px;left:20px;font-family:'Cormorant Garamond',serif;font-size:180px;color:rgba(238,53,36,.25);line-height:1}
.final-quote::after{content:'»';position:absolute;bottom:-90px;right:20px;font-family:'Cormorant Garamond',serif;font-size:180px;color:rgba(238,53,36,.25);line-height:1}
.final-quote .fq-text{font-size:clamp(20px,3.4vw,32px);font-weight:600;line-height:1.35;max-width:820px;margin:0 auto 16px;position:relative;z-index:2}
.final-quote .fq-text em{color:var(--red);font-style:normal}
.final-quote .fq-sub{font-size:14px;color:#b8b8bd;position:relative;z-index:2}
.site-footer{background:var(--graphite-deep);color:#b8b8bd;padding:60px 24px 36px;position:relative;overflow:hidden}
