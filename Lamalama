<script>
var cardsData = [
    { id: 'c1', text: 'Хладнокровие в бою', target: 'ostap' },
    { id: 'c2', text: 'Верность товарищам', target: 'ostap' },
    { id: 'c3', text: 'Упрямство в учебе', target: 'ostap' },
    { id: 'c4', text: 'Чувствительность', target: 'andriy' },
    { id: 'c5', text: 'Безрассудство', target: 'andriy' },
    { id: 'c6', text: 'Легкость в учении', target: 'andriy' },
    { id: 'c7', text: 'Преданность Сечи', target: 'taras' },
    { id: 'c8', text: 'Жестокость к предателям', target: 'taras' },
    { id: 'c9', text: 'Непреклонность', target: 'taras' }
];

var score = 0;
var selectedCard = null;
var totalCards = cardsData.length;

function initTracker(){
    var tracker = document.getElementById('tracker');
    tracker.innerHTML = '';
    tracker.classList.remove('lit');
    for(var i = 0; i < totalCards; i++){
        var candle = document.createElement('div');
        candle.className = 'candle';
        candle.innerHTML = '<div class="glow"></div><div class="flame"></div><div class="wick"></div><div class="wax"></div>';
        tracker.appendChild(candle);
    }
}

function lightCandles(correctCount){
    var candles = document.querySelectorAll('.candle');
    for(var i = 0; i < candles.length; i++){
        (function(candle, index){
            if(index < correctCount){
                setTimeout(function(){ candle.classList.add('lit'); }, index * 120);
            } else {
                candle.classList.remove('lit');
            }
        })(candles[i], i);
    }
    if(correctCount > 0){
        document.getElementById('tracker').classList.add('lit');
    }
}

function shuffleArray(array){
    for(var i = array.length - 1; i > 0; i--){
        var j = Math.floor(Math.random() * (i + 1));
        var t = array[i]; array[i] = array[j]; array[j] = t;
    }
    return array;
}

function startQuiz(){
    score = 0;
    selectedCard = null;
    document.getElementById('game-area').style.display = 'block';
    document.getElementById('final-screen').style.display = 'none';
    document.getElementById('check-btn').style.display = 'none';
    document.getElementById('content-ostap').innerHTML = '';
    document.getElementById('content-andriy').innerHTML = '';
    document.getElementById('content-taras').innerHTML = '';
    initTracker();
    renderPool();
}

function renderPool(){
    var pool = document.getElementById('pool');
    pool.innerHTML = '';
    var shuffled = shuffleArray(cardsData.slice());

    for(var i = 0; i < shuffled.length; i++){
        (function(cardData){
            var card = document.createElement('div');
            card.className = 'card';
            card.innerText = cardData.text;
            card.draggable = true;
            card.id = cardData.id;
            card.dataset.target = cardData.target;
            card.ondragstart = drag;
            card.onclick = function(){ selectCard(card); };
            pool.appendChild(card);
        })(shuffled[i]);
    }
}

function allowDrop(ev){
    ev.preventDefault();
    ev.currentTarget.classList.add('dragover');
}

document.addEventListener('dragleave', function(e){
    if(e.target.classList && e.target.classList.contains('zone')){
        e.target.classList.remove('dragover');
    }
});

function drag(ev){
    ev.dataTransfer.setData('text', ev.target.id);
    ev.target.style.opacity = '0.5';
}

function drop(ev, targetZone){
    ev.preventDefault();
    ev.currentTarget.classList.remove('dragover');
    var cardId = ev.dataTransfer.getData('text');
    var card = document.getElementById(cardId);
    if(!card) return;
    card.style.opacity = '1';
    moveCardToZone(card, targetZone);
}

function selectCard(card){
    if(card.parentElement.classList.contains('zone-content')){
        moveCardToPool(card);
        return;
    }
    if(selectedCard) selectedCard.classList.remove('selected');
    if(selectedCard === card){ selectedCard = null; return; }
    selectedCard = card;
    card.classList.add('selected');
}

document.getElementById('zone-ostap').onclick = function(e){
    if(selectedCard && !e.target.closest('.card') && !e.target.closest('.zone-crest')){
        moveCardToZone(selectedCard, 'ostap');
    }
};
document.getElementById('zone-andriy').onclick = function(e){
    if(selectedCard && !e.target.closest('.card') && !e.target.closest('.zone-crest')){
        moveCardToZone(selectedCard, 'andriy');
    }
};
document.getElementById('zone-taras').onclick = function(e){
    if(selectedCard && !e.target.closest('.card') && !e.target.closest('.zone-crest')){
        moveCardToZone(selectedCard, 'taras');
    }
};

function moveCardToZone(card, zone){
    var targetContent = document.getElementById('content-' + zone);
    card.classList.remove('selected');
    targetContent.appendChild(card);
    selectedCard = null;
    checkAllPlaced();
}

function moveCardToPool(card){
    var pool = document.getElementById('pool');
    card.classList.remove('selected');
    pool.appendChild(card);
    selectedCard = null;
    checkAllPlaced();
}

function checkAllPlaced(){
    var poolCards = document.querySelectorAll('#pool .card');
    if(poolCards.length === 0){
        document.getElementById('check-btn').style.display = 'block';
    } else {
        document.getElementById('check-btn').style.display = 'none';
    }
}

function checkAnswers(){
    var correctCount = 0;
    var allCards = document.querySelectorAll('.card');

    for(var i = 0; i < allCards.length; i++){
        var card = allCards[i];
        var target = card.dataset.target;
        var parentZone = card.closest('.zone');
        if(!parentZone) continue;
        var zoneId = parentZone.id.replace('zone-', '');
        if(zoneId === target){
            card.classList.add('correct');
            correctCount++;
        } else {
            card.classList.add('wrong');
        }
    }

    score = correctCount;
    lightCandles(score);
    document.getElementById('check-btn').style.display = 'none';

    var totalDelay = (score * 120) + 1200;
    setTimeout(function(){
        document.getElementById('game-area').style.display = 'none';
        document.getElementById('final-screen').style.display = 'block';
        document.getElementById('final-score').innerText = score;

        var verdict = '';
        if(score === 9){
            verdict = 'Идеально! Все девять свечей горят — вы отлично чувствуете характеры всех трёх героев. Остап — сталь, Андрий — огонь, Тарас — кремень.';
        } else if(score >= 7){
            verdict = 'Хорошо. Большинство свечей зажглось, но некоторые детали стоит перечитать.';
        } else if(score >= 5){
            verdict = 'Удовлетворительно. Вы путаетесь в характерах героев. Вернитесь к главам об Остапе, Андрие и Тарасе.';
        } else {
            verdict = 'Плохо. Текст прочитан невнимательно. Перечитайте повесть и попробуйте снова.';
        }
        document.getElementById('verdict').innerText = verdict;
    }, totalDelay);
}

startQuiz();
</script>
