<script>
var questions = [
    { text: "Мой дядя самых честных правил,<br>Когда не в шутку <span class='blank'>___</span>,", options: ["занемог","уснул","уехал","слез"], correct: 0, explanation: "Правильно: «занемог». Самое начало романа, которое знают наизусть.", quote: "«Мой дядя самых честных правил, / Когда не в шутку занемог...»" },
    { text: "Я к вам пишу — чего же боле?<br>Что я могу еще <span class='blank'>___</span>?", options: ["писать","сказать","молчать","просить"], correct: 1, explanation: "Правильно: «сказать». Письмо Татьяны к Онегину.", quote: "«Я к вам пишу — чего же боле? / Что я могу еще сказать?»" },
    { text: "Онегин, добрый мой приятель,<br>Родился на брегах <span class='blank'>___</span>,", options: ["Невы","Москвы","Волги","Оки"], correct: 0, explanation: "Правильно: «Невы». Онегин родился в Петербурге.", quote: "«Онегин, добрый мой приятель, / Родился на брегах Невы...»" },
    { text: "Всегда я рад заметить разность<br>Между Онегиным и <span class='blank'>___</span>,", options: ["тобой","Ленским","судьбой","мной"], correct: 3, explanation: "Правильно: «мной». Пушкин подчеркивает разницу между собой и героем.", quote: "«Всегда я рад заметить разность / Между Онегиным и мной...»" },
    { text: "Чем меньше женщину мы любим,<br>Тем легче нравимся мы <span class='blank'>___</span>.", options: ["им","ей","всем","нам"], correct: 1, explanation: "Правильно: «ей». Знаменитая пушкинская строфа.", quote: "«Чем меньше женщину мы любим, / Тем легче нравимся мы ей...»" },
    { text: "Привычка свыше нам дана:<br>Замена счастию <span class='blank'>___</span>.", options: ["есть","дана","она","идеал"], correct: 2, explanation: "Правильно: «она». Слова о привычке, которая заменяет счастье.", quote: "«Привычка свыше нам дана: / Замена счастию она.»" },
    { text: "Но я другому отдана;<br>Я буду век ему <span class='blank'>___</span>.", options: ["верна","верность","верным","нежна"], correct: 0, explanation: "Правильно: «верна». Финальные слова Татьяны.", quote: "«Но я другому отдана; / Я буду век ему верна.»" },
    { text: "Москва... как много в этом звуке<br>Для сердца русского <span class='blank'>___</span>!", options: ["сплелось","сбылось","срослось","слилось"], correct: 3, explanation: "Правильно: «слилось». Патриотические строки о Москве.", quote: "«Москва... как много в этом звуке / Для сердца русского слилось!»" },
