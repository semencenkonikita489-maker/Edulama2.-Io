];

var currentIndex = 0;
var score = 0;
var totalQuestions = questions.length;

function initTracker(){
    var tracker = document.getElementById('tracker');
    tracker.innerHTML = '';
    for(var i = 0; i < totalQuestions; i++){
        var bead = document.createElement('div');
        bead.className = 'bead';
        bead.id = 'bead-' + i;
        tracker.appendChild(bead);
    }
}

function startQuiz(){
    currentIndex = 0;
    score = 0;
    initTracker();
    document.getElementById('game-area').style.display = 'block';
    document.getElementById('final-screen').style.display = 'none';
    showQuestion();
}

function showQuestion(){
    var q = questions[currentIndex];

    var beads = document.querySelectorAll('.bead');
    for(var i = 0; i < beads.length; i++){
        beads[i].classList.remove('active');
        if(i === currentIndex) beads[i].classList.add('active');
    }

    document.getElementById('poem-text').innerHTML = '<span class="verse-inner">' + q.text + '</span>';

    var optionsBox = document.getElementById('options-box');
    optionsBox.innerHTML = '';

    var indices = [0,1,2,3];
    for(var k = indices.length - 1; k > 0; k--){
        var j = Math.floor(Math.random() * (k + 1));
        var tmp = indices[k]; indices[k] = indices[j]; indices[j] = tmp;
    }

    for(var m = 0; m < indices.length; m++){
        (function(idx){
            var btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.type = 'button';
            btn.innerText = q.options[idx];
            btn.dataset.idx = idx;
            btn.onclick = function(){ checkAnswer(idx, btn); };
            optionsBox.appendChild(btn);
        })(indices[m]);
    }

    document.getElementById('feedback-box').style.display = 'none';
    document.getElementById('next-btn').style.display = 'none';
}

function checkAnswer(selectedIndex, btn){
    var q = questions[currentIndex];
    var allBtns = document.querySelectorAll('.option-btn');
    for(var i = 0; i < allBtns.length; i++) allBtns[i].disabled = true;

    var feedbackBox = document.getElementById('feedback-box');
    var feedbackTitle = document.getElementById('feedback-title');
    var feedbackText = document.getElementById('feedback-text');
    var quoteText = document.getElementById('quote-text');
    var bead = document.getElementById('bead-' + currentIndex);

    if(selectedIndex === q.correct){
        score++;
        btn.classList.add('correct');
        bead.classList.add('correct');
        feedbackBox.className = 'feedback correct';
        feedbackTitle.innerText = 'Верно!';
    } else {
        btn.classList.add('wrong');
        for(var j = 0; j < allBtns.length; j++){
            if(parseInt(allBtns[j].dataset.idx, 10) === q.correct){
                allBtns[j].classList.add('correct');
            }
        }
        bead.classList.add('wrong');
        feedbackBox.className = 'feedback wrong';
        feedbackTitle.innerText = 'Увы, это не так.';
    }

    feedbackText.innerText = q.explanation;
    quoteText.innerHTML = '';
    for(var qc = 0; qc < q.quote.length; qc++){
        var qSpan = document.createElement('span');
        qSpan.className = 'ql';
        qSpan.textContent = q.quote.charAt(qc);
        qSpan.style.animationDelay = (qc * 0.03) + 's';
        quoteText.appendChild(qSpan);
    }
    feedbackBox.style.display = 'block';
    document.getElementById('next-btn').style.display = 'block';
}

function nextQuestion(){
    currentIndex++;
    if(currentIndex < totalQuestions){
        showQuestion();
    } else {
        showFinal();
    }
}

function showFinal(){
    document.getElementById('game-area').style.display = 'none';
    document.getElementById('final-screen').style.display = 'block';
    document.getElementById('final-score').innerText = score;
    document.getElementById('final-total').innerText = 'из ' + totalQuestions;

    var percent = (score / totalQuestions) * 100;
    var verdict = '';

    if(percent === 100){
        verdict = 'Безупречно! Вы знаете роман так же хорошо, как сам Пушкин.';
    } else if(percent >= 90){
        verdict = 'Великолепно! Вы очень внимательный читатель, помните даже мельчайшие детали.';
    } else if(percent >= 70){
        verdict = 'Хорошо. Вы знаете сюжет и ключевые строки, но некоторые строфы стоит перечитать.';
    } else if(percent >= 50){
        verdict = 'Удовлетворительно. Есть заметные пробелы в знании текста. Роман стоит перечитать.';
    } else {
        verdict = 'Плохой результат. Текст прочитан невнимательно или не дочитан. Возьмите роман в руки и попробуйте снова.';
    }

    document.getElementById('verdict').innerText = verdict;
}

startQuiz();
</script>
</body>
</html>
