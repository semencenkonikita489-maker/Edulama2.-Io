var MAX_QUESTIONS = 5;
var MIN_EVIDENCE = 3;
var questionsLeft = MAX_QUESTIONS;
var evidenceCount = 0;
var askedIds = new Set();
var foundClues = [];

function startGame(){
    document.getElementById('intro-screen').style.display = 'none';
    document.getElementById('game-screen').style.display = 'block';
    document.getElementById('final-screen').style.display = 'none';
    renderQuestions();
}

function renderQuestions(){
    var grid = document.getElementById('questions-grid');
    grid.innerHTML = '';
    for(var i = 0; i < QUESTIONS.length; i++){
        (function(q){
            var btn = document.createElement('button');
            btn.className = 'q-btn';
            btn.type = 'button';
            btn.innerText = q.question;
            btn.onclick = function(){ askQuestion(q, btn); };
            grid.appendChild(btn);
        })(QUESTIONS[i]);
    }
}

function askQuestion(q, btn){
    if(questionsLeft <= 0 || askedIds.has(q.id)) return;
    askedIds.add(q.id);
    questionsLeft--;
    btn.disabled = true;

    var log = document.getElementById('protocol-log');
    if(log.querySelector('.empty-log')){ log.innerHTML = ''; }

    var entry = document.createElement('div');
    entry.className = 'log-entry';

    var clueHtml = q.key
        ? '<div class="log-clue">УЛИКА: ' + q.clue + '</div>'
        : '<div class="log-no-clue">Улик не обнаружено</div>';

    entry.innerHTML =
        '<div class="log-scene">' + q.scene + '</div>' +
        '<div class="log-q">— Следователь: <b>' + q.question + '</b></div>' +
        '<div class="log-a">— Хлестаков: <b>' + q.answer + '</b></div>' +
        '<div class="text-quote">' + q.quote +
            '<div style="margin-top:10px;font-style:normal;font-family:\'PT Sans\',sans-serif;font-size:13px;color:#555;line-height:1.6;">' + q.context + '</div>' +
            '<span class="source">' + q.source + '</span>' +
        '</div>' +
        clueHtml;

    log.appendChild(entry);
    log.scrollTop = log.scrollHeight;

    if(q.key){
        evidenceCount++;
        foundClues.push({ clue: q.clue, quote: q.quote, context: q.context, source: q.source });
    }

    document.getElementById('q-left').innerText = questionsLeft;
    document.getElementById('ev-count').innerText = evidenceCount;

    if(questionsLeft === 0){
        if(evidenceCount >= MIN_EVIDENCE){
            document.getElementById('accuse-block').style.display = 'block';
        } else {
            showFinal(false);
        }
    }
}

function makeAccusation(){
    showFinal(true);
}

function showFinal(success){
    document.getElementById('game-screen').style.display = 'none';
    document.getElementById('final-screen').style.display = 'block';

    var stamp = document.getElementById('final-stamp');
    var title = document.getElementById('final-title');
    var text = document.getElementById('final-verdict-text');

    if(success){
        stamp.className = 'final-stamp win';
        stamp.innerText = 'ДЕЛО РАСКРЫТО';
        title.innerText = 'Вы доказали: Хлестаков — самозванец';

        if(evidenceCount === 6){
            text.innerText = 'Блестящее расследование. Вы прошли по всем ключевым сценам: трактир, встреча с городничим, просьба о деньгах, похвальба Пушкиным, рассказы о карьере, письмо Тряпичкину. Каждая улика подкреплена подлинной репликой из текста. Дело закрыто безупречно.';
        } else if(evidenceCount === 5){
            text.innerText = 'Отличная работа. Вы собрали почти все улики и доказали, что Хлестаков — самозванец. Каждая улика подкреплена цитатой из комедии. Одна сцена осталась незамеченной, но и без неё обвинение держится.';
        } else if(evidenceCount === 4){
            text.innerText = 'Хорошая работа. Вы собрали четыре улики — этого достаточно, чтобы доказать самозванство. Каждая улика подкреплена цитатой из текста. Но в следующий раз постарайтесь пройти больше ключевых сцен.';
        } else {
            text.innerText = 'Обвинение предъявлено, и его удалось доказать. Трёх улик хватило, чтобы показать: Хлестаков не ревизор. Каждая улика подкреплена подлинной репликой из текста. Но в следующий раз постарайтесь собрать больше доказательств.';
        }
    } else {
        stamp.className = 'final-stamp';
        stamp.innerText = 'ДЕЛО РАЗВАЛИЛОСЬ';
        title.innerText = 'Недостаточно доказательств';
        text.innerText = 'Вы задали пять вопросов, но собрали меньше трёх улик. Без доказательств обвинение в самозванстве невозможно — Хлестаков остался безнаказанным, а чиновники так и не узнали правды. Перечитайте комедию и попробуйте снова: выбирайте вопросы, которые дают конкретные улики с цитатами.';
    }

    renderEvidence();
}

function renderEvidence(){
    var foundList = document.getElementById('ev-found-list');
    var missedList = document.getElementById('ev-missed-list');
    foundList.innerHTML = '';
    missedList.innerHTML = '';

    if(foundClues.length === 0){
        var li = document.createElement('li');
        li.className = 'none-note';
        li.innerText = 'Ни одной улики не собрано.';
        li.style.listStyle = 'none';
        li.style.paddingLeft = '0';
        foundList.appendChild(li);
    } else {
        for(var i = 0; i < foundClues.length; i++){
            var item = foundClues[i];
            var li2 = document.createElement('li');
            li2.innerHTML = '<span class="ev-clue">' + item.clue + '</span><span class="ev-quote">' + item.quote + '</span>';
            foundList.appendChild(li2);
        }
    }

    var missed = QUESTIONS.filter(function(q){ return q.key && !askedIds.has(q.id); });
    if(missed.length === 0){
        var li3 = document.createElement('li');
        li3.className = 'none-note';
        li3.innerText = 'Вы нашли все улики. Отличная работа.';
        li3.style.listStyle = 'none';
        li3.style.paddingLeft = '0';
        missedList.appendChild(li3);
    } else {
        for(var j = 0; j < missed.length; j++){
            var q2 = missed[j];
            var li4 = document.createElement('li');
            li4.innerHTML = '<span class="ev-clue">' + q2.clue + '</span><span class="ev-quote">' + q2.quote + '</span>';
            missedList.appendChild(li4);
        }
    }
}

function restart(){
    location.reload();
}
