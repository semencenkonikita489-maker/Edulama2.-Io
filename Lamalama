<script>
var questions = [
    {text:"Левша был тульским мастером.", answer:true, explanation:"Верно. Левша — тульский оружейник, главный герой сказа.", quote:"«Туляки... люди смышлёные...»"},
    {text:"Блоха, которую показывали в России, была сделана из чистого золота.", answer:false, explanation:"Неверно. Блоха была стальная — английской работы.", quote:"«...подарили англичане стальную блоху...»"},
    {text:"Левша был косой на левый глаз.", answer:true, explanation:"Верно. У Левши был дефект — левый глаз косил.", quote:"«...косой левша, на щеке пятно родимое...»"},
    {text:"Тульские мастера подковали блоху, но подковы не поставили, чтобы она не сломалась.", answer:false, explanation:"Неверно. Мастера именно подковали блоху — и она перестала танцевать.", quote:"«...а блоха перестала танцевать, потому что ей ножки подковали»."},
    {text:"Блоха перестала танцевать после того, как тульские мастера её подковали.", answer:true, explanation:"Верно. Именно в этом и был эффект их работы.", quote:"«...блоха перестала танцевать»."},
    {text:"Генерал Платов был донским казаком, а не английским инженером.", answer:true, explanation:"Верно. Платов — донской казак, генерал, сопровождавший императора.", quote:"«...донской казак Платов...»"},
    {text:"В Англии Левша отказался остаться, потому что тосковал по родине.", answer:true, explanation:"Верно. Левша просил отправить его обратно в Россию.", quote:"«...потому что я желаю в своё отечество...»"},
    {text:"Англичане предлагали Левше остаться и даже хотели женить его на английской невесте.", answer:true, explanation:"Верно. Англичане всячески старались оставить Левшу у себя.", quote:"«...мы тебя женим...»"},
    {text:"Левша успел лично передать государю секрет о том, что англичане ружья кирпичом не чистят.", answer:false, explanation:"Неверно. Левша не успел — его слова так и не дошли до государя.", quote:"«...но его слова не дошли до государя...»"},
    {text:"Перед смертью Левша просил передать государю важный военный секрет.", answer:true, explanation:"Верно. Это и был его последний наказ — рассказать, как правильно чистить ружья.", quote:"«Скажите государю, что у англичан ружья кирпичом не чистят...»"}
];

var currentQuestionIndex = 0;
var score = 0;

function startQuiz(){
    currentQuestionIndex = 0;
    score = 0;
    document.getElementById('game-screen').style.display = 'block';
    document.getElementById('final-screen').style.display = 'none';
    showQuestion();
}

function showQuestion(){
    var q = questions[currentQuestionIndex];
    var qHost = document.getElementById('question-text');
    qHost.innerHTML = '';
    var qSpan = document.createElement('span');
    qSpan.className = 'q-inner';
    qSpan.textContent = q.text;
    qHost.appendChild(qSpan);
    document.getElementById('feedback-box').style.display = 'none';
    document.getElementById('next-btn').style.display = 'none';
    document.getElementById('answer-buttons').style.display = 'flex';

    var allBtns = document.querySelectorAll('#answer-buttons button');
    for(var i = 0; i < allBtns.length; i++) allBtns[i].disabled = false;

    var progressPercent = (currentQuestionIndex / questions.length) * 100;
    document.getElementById('progress-fill').style.width = progressPercent + '%';
    document.getElementById('q-counter').innerText = (currentQuestionIndex + 1) + ' / ' + questions.length;
}

function checkAnswer(userAnswer){
    var q = questions[currentQuestionIndex];
    var allBtns = document.querySelectorAll('#answer-buttons button');
    for(var i = 0; i < allBtns.length; i++) allBtns[i].disabled = true;

    var feedbackBox = document.getElementById('feedback-box');
    var feedbackTitle = document.getElementById('fb-title');
    var feedbackText = document.getElementById('fb-text');
    var quoteText = document.getElementById('quote-text');

    document.getElementById('answer-buttons').style.display = 'none';
    feedbackBox.style.display = 'block';

    if(userAnswer === q.answer){
        score++;
        feedbackBox.className = 'feedback correct';
        feedbackTitle.innerText = '✅ Верно!';
    } else {
        feedbackBox.className = 'feedback wrong';
        feedbackTitle.innerText = '❌ Ошибка';
    }
    feedbackText.innerText = q.explanation;
    quoteText.innerText = q.quote;
    document.getElementById('next-btn').style.display = 'block';
}

function nextQuestion(){
    currentQuestionIndex++;
    if(currentQuestionIndex < questions.length){
        showQuestion();
    } else {
        showFinalScreen();
    }
}

function showFinalScreen(){
    document.getElementById('game-screen').style.display = 'none';
    document.getElementById('final-screen').style.display = 'block';

    var total = questions.length;
    var wrong = total - score;
    var percent = Math.round((score / total) * 100);

    document.getElementById('final-score').innerText = score;
    document.getElementById('final-total').innerText = total;
    document.getElementById('stat-correct').innerText = score;
    document.getElementById('stat-wrong').innerText = wrong;
    document.getElementById('stat-percent').innerText = percent + '%';

    var emoji, verdict;
    if(percent === 100){ emoji = '🏆'; verdict = 'Идеально! Ты знаешь текст наизусть, включая мельчайшие детали.'; }
    else if(percent >= 90){ emoji = '🌟'; verdict = 'Отлично! Очень высокий результат, ты внимательный читатель.'; }
    else if(percent >= 70){ emoji = '👍'; verdict = 'Хорошо. Ты знаешь сюжет, но некоторые детали стоит повторить.'; }
    else if(percent >= 50){ emoji = '📖'; verdict = 'Удовлетворительно. Есть серьёзные пробелы в знании текста.'; }
    else { emoji = '💪'; verdict = 'Плохой результат. Текст прочитан невнимательно или не дочитан. Перечитай сказ и попробуй снова.'; }

    document.getElementById('final-emoji').innerText = emoji;
    document.getElementById('verdict').innerText = verdict;
}

startQuiz();
</script>
