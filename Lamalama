<script>
var totalWords = 8;
var doneCount = 0;
var wordData = {};
var activeInput = null;
var activeWordEl = null;
var activeBox = null;

function normalize(str){return str.toLowerCase().replace(/ё/g,'е').replace(/[^а-яa-z0-9]/g,'');}
function matchesKeywords(userAnswer, keywords){
    var norm = normalize(userAnswer);
    if(!norm) return false;
    return keywords.some(function(k){
        var nk = normalize(k);
        if(!nk) return false;
        if(nk.length <= 3){
            var words = userAnswer.toLowerCase().replace(/ё/g,'е').split(/[\s\-–—,.!?;:()]+/).filter(function(w){return w.length>0;});
            return words.some(function(w){
                var cw = w.replace(/[^а-яa-z0-9]/g,'');
                return cw === nk || cw.indexOf(nk) === 0 || cw.lastIndexOf(nk) === cw.length - nk.length;
            });
        }
        return norm.indexOf(nk) !== -1;
    });
}

function initGame(){
    var clickables = document.querySelectorAll('.clickable');
    for(var i = 0; i < clickables.length; i++){
        (function(el, index){
            var id = 'word-' + index;
            el.dataset.wordId = id;
            wordData[id] = {
                el: el, action: null, userAnswer: null,
                original: el.dataset.original, type: el.dataset.type,
                keywords: el.dataset.keywords.split(',').map(function(k){return k.trim().toLowerCase();})
            };
            el.onclick = function(){ openEdit(el); };
        })(clickables[i], i);
    }
}

function openEdit(el){
    var wd = wordData[el.dataset.wordId];
    if(wd.action !== null) return;
    closeEdit();
    activeWordEl = el;
    var box = document.createElement('div');
    box.className = 'edit-box';
    box.innerHTML = '<div class="edit-label">Что делать с этим словом?</div>' +
        '<input type="text" class="edit-input" placeholder="Впиши правильное слово, если оно неверное..." autocomplete="off">' +
        '<div class="edit-actions">' +
        '<button class="edit-btn edit-save" type="button">Исправить</button>' +
        '<button class="edit-btn edit-ok" type="button">Оставить как есть</button>' +
        '<button class="edit-btn edit-cancel" type="button">Отмена</button>' +
        '</div>';
    el.parentNode.insertBefore(box, el.nextSibling);
    activeInput = box.querySelector('.edit-input');
    activeBox = box;
    activeInput.focus();
    box.querySelector('.edit-save').onclick = saveEdit;
    box.querySelector('.edit-ok').onclick = confirmWord;
    box.querySelector('.edit-cancel').onclick = closeEdit;
    activeInput.addEventListener('keydown', function(e){
        if(e.key === 'Enter') saveEdit();
        if(e.key === 'Escape') closeEdit();
    });
}

function closeEdit(){
    if(activeBox){ activeBox.remove(); activeBox = null; }
    activeInput = null; activeWordEl = null;
}

function saveEdit(){
    if(!activeInput || !activeWordEl) return;
    var userAnswer = activeInput.value.trim();
    if(!userAnswer){ activeInput.focus(); return; }
    var el = activeWordEl;
    var wd = wordData[el.dataset.wordId];
    wd.action = 'fix'; wd.userAnswer = userAnswer;
    el.classList.add('processed'); el.innerText = userAnswer;
    doneCount++; updateUI(); closeEdit();
}

function confirmWord(){
    if(!activeWordEl) return;
    var el = activeWordEl;
    var wd = wordData[el.dataset.wordId];
    wd.action = 'keep'; wd.userAnswer = null;
    el.classList.add('processed');
    doneCount++; updateUI(); closeEdit();
}

function updateUI(){
    document.getElementById('done-count').innerText = doneCount;
    var btn = document.getElementById('submit-btn');
    var hint = document.getElementById('submit-hint');
    if(doneCount >= totalWords){
        btn.disabled = false;
        hint.innerText = 'Все слова обработаны. Готов сдать работу?';
    } else {
        btn.disabled = true;
        hint.innerText = 'Осталось обработать слов: ' + (totalWords - doneCount);
    }
}

function submitWork(){
    var fixedErrors = 0, missedErrors = 0, brokenCorrect = 0;
    for(var id in wordData){
        var wd = wordData[id];
        if(wd.type === 'error'){
            if(wd.action === 'fix'){
                if(matchesKeywords(wd.userAnswer, wd.keywords)) fixedErrors++;
                else missedErrors++;
            } else if(wd.action === 'keep'){ missedErrors++; }
        } else {
            if(wd.action === 'fix'){
                if(!matchesKeywords(wd.userAnswer, wd.keywords)) brokenCorrect++;
            }
        }
    }
    var won = (fixedErrors === 5) && (brokenCorrect === 0) && (missedErrors === 0);
    if(won){
        document.getElementById('scene-won').classList.add('show');
        setTimeout(function(){ document.getElementById('vasyutka').classList.add('waving'); }, 6000);
    } else {
        var lostText = document.getElementById('lost-text');
        var reason = '';
        if(fixedErrors === 5 && brokenCorrect > 0){
            reason = 'Ты исправил все 5 ошибок, но испортил ' + brokenCorrect + ' правильных ' + (brokenCorrect === 1 ? 'слова' : 'слов') + '. Тайга такого не прощает.';
        } else {
            reason = 'Ты исправил ' + fixedErrors + ' из 5 ошибок и пропустил ' + missedErrors + '. Этого мало.';
            if(brokenCorrect > 0){
                reason += ' А ещё испортил ' + brokenCorrect + ' правильных ' + (brokenCorrect === 1 ? 'слова' : 'слов') + '.';
            }
        }
        lostText.innerText = reason + ' В тайге ночь. Полная луна. Волки выходят из леса.';
        document.getElementById('scene-lost').classList.add('show');
    }
}

function restart(){ location.reload(); }
initGame();
</script>
